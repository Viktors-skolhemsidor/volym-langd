        renderQuestions(questionsDel1, 'del1-container');
        renderQuestions(questionsDel2, 'del2-container');
        renderQuestions(questionsDel3, 'del3-container');
        renderQuestions(questionsDel4, 'del4-container');

        // Sätt dagens datum automatiskt
        document.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            const dateInput = document.getElementById('student-date');
            if (dateInput && !dateInput.value) {
                dateInput.value = today;
            }
        });

        // Intelligent rättningsfunktion: Godkänner med eller utan enhet, kommatecken, punkt och variationer i ord
        function checkAnswer(rawInput, question) {
            if (!rawInput || !rawInput.trim()) return false;
            
            const input = rawInput.trim().toLowerCase().replace(',', '.');
            const targetAns = question.ans.toLowerCase().replace(',', '.');

            // Exakt matchning efter normalisering av mellanslag
            const cleanInput = input.replace(/\s+/g, ' ');
            const cleanTarget = targetAns.replace(/\s+/g, ' ');
            if (cleanInput === cleanTarget) return true;

            // Extrahera siffror och jämför
            const inputNumMatch = input.match(/-?\d+(\.\d+)?/);
            if (inputNumMatch && typeof question.num === 'number') {
                const inputNum = parseFloat(inputNumMatch[0]);
                if (Math.abs(inputNum - question.num) < 0.001) {
                    const nonNumPart = input.replace(inputNumMatch[0], '').replace(/\s+/g, '').replace(/[\.,]/g, '');
                    
                    // Om eleven bara skrivit siffran (t.ex. "10" istället för "10 dl" eller "10 dm")
                    if (nonNumPart === '') return true;

                    // Volymenheter
                    if (cleanTarget.includes('dl') && (nonNumPart === 'dl' || nonNumPart === 'deciliter')) return true;
                    if (cleanTarget.includes('cl') && (nonNumPart === 'cl' || nonNumPart === 'centiliter')) return true;
                    if (cleanTarget.includes('l') && !cleanTarget.includes('cl') && !cleanTarget.includes('dl') && (nonNumPart === 'l' || nonNumPart === 'liter')) return true;

                    // Längdenheter
                    if (cleanTarget.includes('dm') && (nonNumPart === 'dm' || nonNumPart === 'decimeter')) return true;
                    if (cleanTarget.includes('cm') && (nonNumPart === 'cm' || nonNumPart === 'centimeter')) return true;
                    if (cleanTarget.includes('m') && !cleanTarget.includes('dm') && !cleanTarget.includes('cm') && (nonNumPart === 'm' || nonNumPart === 'meter')) return true;

                    // Ord-enheter och beteckningar
                    if (cleanTarget.includes('gång') && (nonNumPart.startsWith('gång') || nonNumPart === 'ggr')) return true;
                    if (cleanTarget.includes('skop') && nonNumPart.startsWith('skop')) return true;
                    if (cleanTarget.includes('flask') && nonNumPart.startsWith('flask')) return true;
                    if (cleanTarget.includes('mugg') && nonNumPart.startsWith('mugg')) return true;
                    if (cleanTarget.includes('timm') && (nonNumPart.startsWith('timm') || nonNumPart === 'h')) return true;
                    if (cleanTarget.includes('minut') && nonNumPart.startsWith('min')) return true;
                    if (cleanTarget.includes('sekund') && (nonNumPart.startsWith('sek') || nonNumPart === 's')) return true;
                    if (cleanTarget.includes('vänd') && nonNumPart.startsWith('vänd')) return true;
                }
            }
            return false;
        }

        // Utvärdera hela provet
        function evaluateTest() {
            const allQuestions = [...questionsDel1, ...questionsDel2, ...questionsDel3, ...questionsDel4];
            let answeredCount = 0;
            let correctCount = 0;
            const details = [];

            allQuestions.forEach(q => {
                const input = document.getElementById(`ans-${q.id}`);
                const val = input ? input.value.trim() : '';
                const isAnswered = val !== '';
                if (isAnswered) answeredCount++;

                const isCorrect = checkAnswer(val, q);
                if (isCorrect) correctCount++;

                details.push({
                    id: q.id,
                    questionText: q.text,
                    userAns: val,
                    correctAns: q.ans,
                    isCorrect: isCorrect,
                    isAnswered: isAnswered,
                    isVolume: q.id % 2 !== 0
                });
            });

            return {
                total: allQuestions.length,
                answered: answeredCount,
                correct: correctCount,
                wrong: allQuestions.length - correctCount,
                percent: Math.round((correctCount / allQuestions.length) * 100),
                details: details
            };
        }

        // Markera visuellt på elevens arbetsblad
        function applyVisualGrading(evaluation) {
            evaluation.details.forEach(item => {
                const card = document.getElementById(`card-${item.id}`);
                const input = document.getElementById(`ans-${item.id}`);
                const badge = document.getElementById(`feedback-${item.id}`);
                if (!card || !badge || !input) return;

                badge.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'bg-rose-100', 'text-rose-800', 'bg-slate-100', 'text-slate-600');
                card.classList.remove('border-emerald-400', 'border-rose-400', 'bg-emerald-50/20', 'bg-rose-50/20');

                if (item.isCorrect) {
                    badge.innerHTML = `✅ Rätt!`;
                    badge.classList.add('bg-emerald-100', 'text-emerald-800');
                    card.classList.add('border-emerald-400', 'bg-emerald-50/20');
                    input.classList.add('text-emerald-700', 'border-emerald-500');
                } else if (item.isAnswered) {
                    badge.innerHTML = `❌ Fel! (Facit: ${item.correctAns})`;
                    badge.classList.add('bg-rose-100', 'text-rose-800');
                    card.classList.add('border-rose-400', 'bg-rose-50/20');
                    input.classList.add('text-rose-700', 'border-rose-500');
                } else {
                    badge.innerHTML = `⚪ Ej besvarad (Facit: ${item.correctAns})`;
                    badge.classList.add('bg-slate-100', 'text-slate-600');
                    card.classList.add('border-slate-300');
                }
            });
        }

        function openSubmitModal() {
            const name = document.getElementById('student-name').value.trim();
            const klass = document.getElementById('student-class').value.trim();
            const modalAlert = document.getElementById('modal-alert');

            if (!name) {
                modalAlert.textContent = "⚠️ Skriv ditt namn högst upp på sidan innan du lämnar in!";
                modalAlert.classList.remove('hidden');
            } else {
                modalAlert.classList.add('hidden');
            }

            const evalRes = evaluateTest();

            applyVisualGrading(evalRes);

            document.getElementById('modal-student-name').textContent = name || "(Inget namn angivet)";
            document.getElementById('modal-student-class').textContent = klass || "(Ingen klass angiven)";
            
            const scoreBadge = document.getElementById('modal-score-badge');
            scoreBadge.textContent = `${evalRes.correct} av ${evalRes.total} rätt (${evalRes.percent}%)`;
            scoreBadge.className = evalRes.percent >= 80 ? 'text-2xl font-extrabold text-emerald-600' : (evalRes.percent >= 50 ? 'text-2xl font-extrabold text-amber-600' : 'text-2xl font-extrabold text-rose-600');

            const progressBar = document.getElementById('modal-progress-bar');
            progressBar.style.width = `${evalRes.percent}%`;
            progressBar.className = evalRes.percent >= 80 ? 'bg-emerald-500 h-full transition-all duration-500' : (evalRes.percent >= 50 ? 'bg-amber-500 h-full transition-all duration-500' : 'bg-rose-500 h-full transition-all duration-500');

            document.getElementById('modal-correct-count').textContent = `${evalRes.correct} Rätta svar`;
            document.getElementById('modal-wrong-count').textContent = `${evalRes.wrong} Fel / Ej svar`;

            document.getElementById('submit-modal').classList.remove('hidden');
        }

        function closeSubmitModal() {
            document.getElementById('submit-modal').classList.add('hidden');
        }

        function getGradedSubmissionSummaryText() {
            const name = document.getElementById('student-name').value.trim() || 'Okänd elev';
            const klass = document.getElementById('student-class').value.trim() || 'Ej angiven';
            const date = document.getElementById('student-date').value.trim() || new Date().toISOString().split('T')[0];
            const evalRes = evaluateTest();

            // Räkna ut resultat för volym, längd, de fyra delarna samt lista alla fel
            let volCorrect = 0;
            let lenCorrect = 0;
            let p1Correct = 0, p2Correct = 0, p3Correct = 0, p4Correct = 0;
            const wrongItems = [];

            evalRes.details.forEach(item => {
                if (item.isCorrect) {
                    if (item.isVolume) volCorrect++;
                    else lenCorrect++;

                    if (item.id <= 30) p1Correct++;
                    else if (item.id <= 60) p2Correct++;
                    else if (item.id <= 90) p3Correct++;
                    else p4Correct++;
                } else {
                    wrongItems.push(`Nr ${item.id} (${item.isVolume ? '💧 Volym' : '📏 Längd'})`);
                }
            });

            const volPercent = Math.round((volCorrect / 55) * 100);
            const lenPercent = Math.round((lenCorrect / 55) * 100);

            const wrongSummary = wrongItems.length > 0 
                ? `${wrongItems.length} st fel/obesvarade:\n  → ${wrongItems.join(', ')}`
                : 'Inga fel! Eleven hade alla 110 uppgifter helt rätt! 🎉';

            let text = `============================================================\n` +
                       `📊 SNABBÖVERBLICK – RESULTAT\n` +
                       `============================================================\n` +
                       `Elev:     ${name}\n` +
                       `Klass:    ${klass}\n` +
                       `Datum:    ${date}\n` +
                       `------------------------------------------------------------\n` +
                       `🏆 TOTALPOÄNG: ${evalRes.correct} av ${evalRes.total} rätt (${evalRes.percent}%)\n` +
                       `💧 Volym (55 uppg):  ${volCorrect} / 55 rätt (${volPercent}%)\n` +
                       `📏 Längd (55 uppg):  ${lenCorrect} / 55 rätt (${lenPercent}%)\n` +
                       `------------------------------------------------------------\n` +
                       `RESULTAT PER DEL:\n` +
                       `• Del 1 (l ↔ dl & m ↔ dm):   ${p1Correct} / 30 rätt\n` +
                       `• Del 2 (dl ↔ cl & dm ↔ cm):  ${p2Correct} / 30 rätt\n` +
                       `• Del 3 (l ↔ cl & m ↔ cm):   ${p3Correct} / 30 rätt\n` +
                       `• Del 4 (Flerstegsproblem):   ${p4Correct} / 20 rätt\n` +
                       `------------------------------------------------------------\n` +
                       `⚠️ ATT FÖLJA UPP:\n` +
                       `${wrongSummary}\n` +
                       `============================================================\n\n` +
                       `DETALJERAD RÄTTNING (ALLA 110 UPPGIFTER):\n` +
                       `------------------------------------------------------------\n`;

            evalRes.details.forEach(item => {
                const icon = item.isVolume ? '💧' : '📏';
                if (item.isCorrect) {
                    text += `✅ Uppgift ${item.id} [${icon}]: "${item.userAns}" — RÄTT\n`;
                } else if (item.isAnswered) {
                    text += `❌ Uppgift ${item.id} [${icon}]: "${item.userAns}" — FEL (Facit: ${item.correctAns})\n`;
                } else {
                    text += `⚪ Uppgift ${item.id} [${icon}]: (Ej besvarad) — (Facit: ${item.correctAns})\n`;
                }
            });

            return text;
        }

        function sendEmail() {
            const teacherEmail = document.getElementById('teacher-email').value.trim();
            const name = document.getElementById('student-name').value.trim() || 'Elev';
            const evalRes = evaluateTest();
            const body = encodeURIComponent(getGradedSubmissionSummaryText());
            const subject = encodeURIComponent(`Rättad inlämning: Volym & Längd - ${name} (${evalRes.correct}/${evalRes.total} rätt)`);

            window.location.href = `mailto:${teacherEmail}?subject=${subject}&body=${body}`;
        }

        function copySubmissionText() {
            const summaryText = getGradedSubmissionSummaryText();
            const textArea = document.getElementById('clipboard-textarea');
            textArea.value = summaryText;
            textArea.select();
            
            try {
                document.execCommand('copy');
                showNotification("Rättat resultat har kopierats med ✅ och ❌! Du kan klistra in det i Google Classroom, Teams eller e-post.");
            } catch (err) {
                showNotification("Kunde inte kopiera automatiskt.");
            }
        }

        function printWithSubmissionStamp() {
            const name = document.getElementById('student-name').value.trim() || 'Elev';
            const date = document.getElementById('student-date').value.trim();
            const evalRes = evaluateTest();
            
            applyVisualGrading(evalRes);

            const stamp = document.getElementById('submission-stamp');
            stamp.innerHTML = `<strong>Rättat resultat:</strong> Elev: <strong>${name}</strong> | Datum: ${date} | Resultat: <strong>${evalRes.correct}/${evalRes.total} rätt (${evalRes.percent}%)</strong> ✅`;
            stamp.classList.remove('hidden');

            closeSubmitModal();
            window.print();
        }

        function showNotification(msg) {
            let toast = document.getElementById('toast-notification');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'toast-notification';
                toast.className = 'fixed bottom-5 right-5 bg-slate-900 text-white px-5 py-3 rounded-xl shadow-2xl text-sm font-medium z-50 transition transform duration-300 translate-y-10 opacity-0 max-w-md';
                document.body.appendChild(toast);
            }
            toast.textContent = msg;
            toast.classList.remove('translate-y-10', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-10', 'opacity-0');
            }, 4500);
        }
    </script>
