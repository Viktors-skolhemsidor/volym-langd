                const isVolume = q.id % 2 !== 0;
                const typeBadge = isVolume 
                    ? `<span class="inline-flex items-center text-[11px] font-semibold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md border border-blue-200">💧 Volym</span>`
                    : `<span class="inline-flex items-center text-[11px] font-semibold text-teal-700 bg-teal-50 px-2 py-0.5 rounded-md border border-teal-200">📏 Längd</span>`;

                const card = document.createElement('div');
                card.id = `card-${q.id}`;
                card.className = "card p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition bg-white";
